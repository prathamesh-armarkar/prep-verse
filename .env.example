# PrepVerse Frontend Environment Variables
#
# Copy this file to `.env` and adjust values as needed.
# Vite exposes variables prefixed with VITE_ to client-side code.

# Base URL for the backend API used by most services (auth, profile,
# dashboard, roadmap, assistant). Defaults to the local Flask server.
VITE_API_BASE_URL=http://localhost:5000

# Base URL used by the resume service (upload, history, latest, compare).
# Keep in sync with VITE_API_BASE_URL.
VITE_API_URL=http://localhost:5000

